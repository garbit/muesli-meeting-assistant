{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muesli",
  "identifier": "dev.garbett.muesli",
  "build": {
    "beforeDevCommand": "scripts/build-sidecar.sh release && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "scripts/build-sidecar.sh release && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Muesli",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/Library/Application Support/Muesli/meetings/**",
          "$TEMP/muesli-headless/meetings/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": false,
    "externalBin": [
      "binaries/muesli-sidecar"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.4",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/garbit/muesli-meeting-assistant/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1OTA0QTRCRUFFMjQ4NUEKUldSYVNPTHFTMHFRdGZzS3RNNXJNM1VlNU9POG5OZFl4ejE0WFJXbllIdFV6YVdpN1hmZTNiZmoK"
    }
  }
}
